    "deploy:dev:ci": "alchemy deploy alchemy.run.ts --stage dev --yes",
    "deploy:prod": "alchemy deploy alchemy.run.ts --stage prod",
    "deploy:prod:ci": "alchemy deploy alchemy.run.ts --stage prod --yes",
    "deploy:staging": "alchemy deploy alchemy.run.ts --stage staging",
    "deploy:staging:ci": "alchemy deploy alchemy.run.ts --stage staging --yes",
    "plan": "alchemy plan alchemy.run.ts",
    "plan:dev": "alchemy plan alchemy.run.ts --stage dev",
    "plan:prod": "alchemy plan alchemy.run.ts --stage prod",
    "plan:staging": "alchemy plan alchemy.run.ts --stage staging",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "2.0.0-beta.65",

{
  "name": "@glass/desktop",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vp build --config vite.main.config.ts && vp build --config vite.preload.config.ts",
    "dev": "vp run --filter @glass/web build && vp run build && node scripts/start-electron.mjs",
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "start": "node scripts/start-electron.mjs",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@glass/contracts": "workspace:*",
    "electron": "41.5.0"
  },
  "devDependencies": {
    "@glass/web": "workspace:*",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
